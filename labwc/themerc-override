# window border
window.active.border.color: #62bac6
window.inactive.border.color: #eac786

# ToggleKeybinds status indicator
window.active.indicator.toggled-keybind.color: #e27881

# window titlebar background
window.active.title.bg.color: #62bac6
window.inactive.title.bg.color: #eac786

window.active.label.text.color: #21252b
window.inactive.label.text.color: #21252b
window.label.text.justify: center

# window button hover overlay
window.button.hover.bg.color: #313640

# window buttons
window.active.button.unpressed.image.color: #21252b
window.inactive.button.unpressed.image.color: #21252b

# menu
menu.border.color: #21252b
menu.items.bg.color: #62bac6
menu.items.text.color: #21252b
menu.items.active.bg.color: #eac786
menu.items.active.text.color: #21252b
menu.separator.color: #21252b
menu.title.bg.color: #62bac6
menu.title.text.color: #21252b

# on screen display (window-cycle dialog)
osd.bg.color: #62bac6
osd.border.color: #21252b
osd.label.text.color: #21252b
osd.window-switcher.preview.border.color: #666e7e
