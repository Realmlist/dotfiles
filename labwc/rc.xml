<?xml version="1.0" ?>
<labwc_config>
  <theme>
    <name>noctalia</name>
    <icon>papirus</icon>
    <cornerRadius>10</cornerRadius>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
      <dropShadows>yes</dropShadows>
      <dropShadowsOnTiled>yes</dropShadowsOnTiled>
    </titlebar>
  </theme>
  
  <!-- CORE CONFIG -->

  <core>
    <gap>10</gap>
    <!-- <hdr>yes</hdr> -->
    <primarySelection>yes</primarySelection>
  </core>

  <placement>
    <policy>automatic</policy>
  </placement>
  
  <!-- Thumbnail-based window switcher -->
  <windowSwitcher preview="no" outlines="yes">
    <osd style="thumbnail"/>
  </windowSwitcher>
  
  <!-- KEYBOARD CONFIG-->
  
  <keyboard>
    <default /> <!-- TECHNICAL NOTE: The <default/> element includes all the built-in keybinds as described here: https://labwc.github.io/labwc-config.5.html#entry_keyboard_default -->
    <numlock>on</numlock>

    <!-- The W- prefix refers to the Super key -->
    <keybind key="W-t">
      <action name="Execute" command="kitty" />
    </keybind>
    <keybind key="W-r">
      <action name="Execute" command="labwc --reconfigure" />
    </keybind>
    <keybind key="W-;">
      <action name="Execute" command="emote" />
    </keybind>
    <keybind key="Print">
      <action name="Execute">
        <command>sh -c 'grim -g "$(slurp)" - | swappy -f -'</command>
      </action>
    </keybind>
    
    <!-- # NOCTALIA # -->
    <!-- Core keys -->
    <keybind key="W-space"><action name="Execute"><command>qs -c noctalia-shell ipc call launcher toggle</command></action></keybind>
    <keybind key="Super_L" onRelease="yes"><action name="Execute"><command>qs -c noctalia-shell ipc call launcher toggle</command></action></keybind>
    <keybind key="W-s"><action name="Execute"><command>qs -c noctalia-shell ipc call controlCenter toggle</command></action></keybind>
    <keybind key="W-,"><action name="Execute"><command>qs -c noctalia-shell ipc call settings toggle</command></action></keybind>

    <!-- Media keys -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute"><command>qs -c noctalia-shell ipc call volume increase</command></action></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute"><command>qs -c noctalia-shell ipc call volume decrease</command></action></keybind>
    <keybind key="XF86AudioMute"><action name="Execute"><command>qs -c noctalia-shell ipc call volume muteOutput</command></action></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute"><command>qs -c noctalia-shell ipc call brightness increase</command></action></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute"><command>qs -c noctalia-shell ipc call brightness decrease</command></action></keybind>
    <!-- # /NOCTALIA # -->
    
  </keyboard>



</labwc_config>